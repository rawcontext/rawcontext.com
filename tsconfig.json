{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"baseUrl": ".",
		"paths": {
			"@/*": [
				"./src/*"
			]
		},
		"types": [
			"@webgpu/types",
			"node"
		]
	},
	"include": [
		".astro/types.d.ts",
		"src/**/*",
		"api/**/*"
	],
	"exclude": [
		"dist"
	]
}
